{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickMate",
  "version": "0.1.27",
  "identifier": "com.stickmate.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "/",
        "decorations": false,
        "transparent": false,
        "width": 420,
        "height": 320,
        "center": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "main",
        "url": "/",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false
      },
      {
        "label": "editor",
        "url": "/",
        "decorations": false,
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCNTUyOUY4ODNBRTFCMTQKUldRVUc2NkQrQ2xWSzhoY0E4Snh1L05NWEVLZ3JXNXpTSU9zd3N4SW1HeE9NT2tucStybTM0VzQK",
      "endpoints": [
        "https://github.com/SkenSMasteR/StickMate/releases/latest/download/latest.json"
      ]
    }
  }
}
