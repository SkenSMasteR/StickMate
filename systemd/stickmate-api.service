[Unit]
Description=StickMate API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stickmate
Group=stickmate
WorkingDirectory=/opt/stickmate/current/server
EnvironmentFile=/etc/stickmate/stickmate.env
Environment=STICKMATE_DATA_DIR=/opt/stickmate/data
ExecStart=/opt/stickmate/venv/bin/python /opt/stickmate/current/server/app.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/stickmate/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target